# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (test mode keys for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (used to send the contact form to CONTACT_EMAIL)
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Inaya Farm <contact@yourdomain.com>
# CONTACT_EMAIL=inaya.farm@gmail.com

# Google Calendar — service account with access to the "Veto" calendar.
# Create the service account in Google Cloud Console, enable the Calendar API,
# then share the "Veto" calendar with the service account's email (permission:
# "Make changes to events"). GOOGLE_CALENDAR_ID is that calendar's id (Settings
# > Integrate calendar > Calendar ID).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
