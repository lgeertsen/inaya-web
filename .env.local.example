# Supabase — Settings > API Keys > "Publishable and secret API keys" tab
# (https://supabase.com/dashboard/project/_/settings/api-keys). Use the
# sb_publishable_... and sb_secret_... keys, not the legacy anon/service_role
# JWTs — the env var names below are just our own naming, not Supabase's.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (test mode keys for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (used to send the contact form to CONTACT_EMAIL)
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Inaya Farm <contact@yourdomain.com>
# CONTACT_EMAIL=inaya.farm@gmail.com

# Google Calendar — service account with access to the "Veto" and "Vaccins"
# calendars. Create the service account in Google Cloud Console, enable the
# Calendar API, then share both calendars with the service account's email
# (permission: "Make changes to events"). GOOGLE_CALENDAR_ID /
# GOOGLE_VACCINE_CALENDAR_ID are each calendar's id (Settings > Integrate
# calendar > Calendar ID).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_VACCINE_CALENDAR_ID=

# Google Maps — https://console.cloud.google.com/google/maps-apis/credentials
# Enable the "Maps JavaScript API", create an API key, and restrict it to this
# site's domain(s). Powers the styled map on the contact page; without it, the
# contact page falls back to a "view on Google Maps" link.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
